# ===== AI PROVIDER CONFIGURATION WITH AUTOMATIC FALLBACK =====
ENVIRONMENT=development

# 
# IMPORTANT: Set BOTH API keys below for automatic fallback to work!
# When your primary provider hits rate limit, system automatically switches to fallback.
#
# Example:
#   AI_PROVIDER=huggingface (primary)
#   HUGGINGFACE_API_KEY=hf_xxxx (will be used first)
#   GEMINI_API_KEY=AIzaSyD_xxxx (fallback if HF hits rate limit)
#

# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/
# Rate limit: 15 requests per minute (free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face API Configuration
# Get your API key from: https://huggingface.co/settings/tokens
# Rate limit: Varies by model (usually 30 req/min for free tier)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# AI Provider Selection: "gemini" or "huggingface"
# This is the PRIMARY provider. If it fails, system switches to the other one.
# Change this to switch which provider is tried first
AI_PROVIDER=huggingface

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ai_agent_db

# Alternative for SQLite (for development)
# DATABASE_URL=sqlite:///./ai_agent.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Security (generate secure keys for production)
SECRET_KEY=your-secret-key-here-generate-a-secure-one
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REUSE_REVOKE_ALL=True

# Optional: Rate limiting
MAX_REQUESTS_PER_MINUTE=60

# Reliability and fallback resilience
GEMINI_TIMEOUT_SECONDS=18
AI_RETRY_ATTEMPTS=2
AI_RETRY_BASE_DELAY_SECONDS=0.8
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=45

# Security headers
ENABLE_SECURITY_HEADERS=True
HSTS_MAX_AGE_SECONDS=31536000

# Billing / Stripe Checkout
PREMIUM_MONTHLY_PRICE_CENTS=1499
PREMIUM_YEARLY_PRICE_CENTS=11999
FREE_PREMIUM_DAILY_QUOTA=3
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_SUCCESS_URL=http://localhost:3000/?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/?billing=cancelled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
