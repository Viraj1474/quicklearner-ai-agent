# Backend environment (production)
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=use-a-64-char-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REUSE_REVOKE_ALL=True

# Database (recommended: PostgreSQL)
DATABASE_URL=postgresql+psycopg2://user:password@db-host:5432/ai_agent

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
GEMINI_TIMEOUT_SECONDS=20
AI_RETRY_ATTEMPTS=0
AI_RETRY_BASE_DELAY_SECONDS=1.0
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# CORS (explicit allowlist only)
CORS_ORIGINS=https://your-frontend-domain.com

# Security headers
ENABLE_SECURITY_HEADERS=True
HSTS_MAX_AGE_SECONDS=31536000

# Optional OAuth / Email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=AI Study Assistant
FRONTEND_URL=https://your-frontend-domain.com

# Billing / Stripe Checkout
PREMIUM_MONTHLY_PRICE_CENTS=1499
PREMIUM_YEARLY_PRICE_CENTS=11999
FREE_PREMIUM_DAILY_QUOTA=3
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_SUCCESS_URL=https://your-frontend-domain.com/?billing=success
STRIPE_CANCEL_URL=https://your-frontend-domain.com/?billing=cancelled
